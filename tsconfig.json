{
  "include": ["**/*.ts", "**/*.tsx", "eslint.config.js", "prettier.config.js"],
  "exclude": ["node_modules", "dist", "src/parked"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "@tanstack/react-router": ["./src/astro/router-shim.tsx"],
      "@/lib/content": ["./src/astro/content-client.ts"],
      "@/lib/plugins": ["./src/astro/plugins-client.ts"],
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "astro/client"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
