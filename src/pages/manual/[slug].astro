---
import { locale, locales } from '@/i18n/site'
import Base from '../../layouts/Base.astro'
import ManualShell from '../../layouts/ManualShell.astro'
import { ManualSidebar } from '@/components/ManualLayout'
import { ManualChapterView } from '@/components/ManualChapterView'
import { getManualChapter, getManualToc } from '../../astro/data'
import { headProps } from '../../astro/head'
import { chapterSeo } from '../../astro/page-seo'

export function getStaticPaths() {
  return getManualToc()
    .filter((entry) => entry.slug !== 'index')
    .map((entry) => ({ params: { slug: entry.slug } }))
}

const { slug } = Astro.params
const data = getManualChapter(slug ?? '')
if (!data.chapter) throw new Error(`Manual chapter not found: ${slug}`)
const head = headProps(chapterSeo(data, slug ?? ''), `/manual/${slug}/`)
if (!locale.manual) return Astro.redirect(locales.en.domain + Astro.url.pathname, 302)

---
<Base {...head}>
  <ManualShell toc={data.toc} activePath={`/manual/${slug}/`}>
    <ManualSidebar
      slot="nav"
      client:load
      toc={data.toc}
      activePath={`/manual/${slug}/`}
      transition:persist="manual-sidebar"
    />
    <ManualChapterView data={data} />
  </ManualShell>
</Base>
