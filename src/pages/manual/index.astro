---
import { locale, locales } from '@/i18n/site'
import Base from '../../layouts/Base.astro'
import ManualShell from '../../layouts/ManualShell.astro'
import { ManualSidebar } from '@/components/ManualLayout'
import { ManualChapterView } from '@/components/ManualChapterView'
import { getManualChapter } from '../../astro/data'
import { headProps } from '../../astro/head'
import { manualIndexSeo } from '../../astro/page-seo'

const data = getManualChapter('index')
const head = headProps(manualIndexSeo(), '/manual/')
if (!locale.manual) return Astro.redirect(locales.en.domain + Astro.url.pathname, 302)

---
<Base {...head}>
  <ManualShell toc={data.toc} activePath="/manual/">
    <ManualSidebar
      slot="nav"
      client:load
      toc={data.toc}
      activePath="/manual/"
      transition:persist="manual-sidebar"
    />
    <ManualChapterView data={data} />
  </ManualShell>
</Base>
