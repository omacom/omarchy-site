      <article class="news-post">
        <header class="news-post__header">
          <p class="news-meta">
            <span class="news-byline">By <%= post.author_url ? %(<a href="#{h post.author_url}" rel="author">#{h post.author}</a>) : h(post.author) %></span> on <time class="news-date" datetime="<%= post.date.iso8601 %>"><%= h format_date(post.date) %></time>
          </p>
          <h1 class="news-post__title"><%= h post.title %></h1>
        </header>

        <div class="news-prose">
<%= post.html -%>
        </div>
      </article>
