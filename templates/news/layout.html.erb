<!doctype html>

<html lang="en">
  <head>
    <title><%= h page_title %></title>

    <meta charset="utf-8">
    <meta name="viewport" content="initial-scale=1, width=device-width">
    <meta name="description" content="<%= h description %>">
    <meta name="author" content="<%= h author %>">

    <link rel="canonical" href="<%= h canonical_url %>">
    <link rel="alternate" type="application/rss+xml" title="Omarchy News" href="https://omarchy.org/news/rss.xml">
    <link rel="icon" href="/assets/images/favicon.png">

    <meta property="og:site_name" content="Omarchy News">
    <meta property="og:title" content="<%= h social_title %>">
    <meta property="og:description" content="<%= h description %>">
    <meta property="og:image" content="https://omarchy.org/assets/images/social.png">
    <meta property="og:image:width" content="600">
    <meta property="og:image:height" content="600">
    <meta property="og:image:alt" content="Omarchy logo">
    <meta property="og:url" content="<%= h canonical_url %>">
    <meta property="og:type" content="<%= article ? "article" : "website" %>">
<% if article -%>
    <meta property="article:published_time" content="<%= published_at.iso8601 %>">
    <meta property="article:author" content="<%= h author %>">
<% end -%>

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= h social_title %>">
    <meta name="twitter:description" content="<%= h description %>">
    <meta name="twitter:image" content="https://omarchy.org/assets/images/social.png">
    <meta name="twitter:image:alt" content="Omarchy logo">

    <script type="application/ld+json"><%= json_ld %></script>

    <link rel="stylesheet" href="/assets/css/reset.css">
    <link rel="stylesheet" href="/assets/css/root.css">
    <link rel="stylesheet" href="/assets/css/palettes.css">
    <link rel="stylesheet" href="/assets/css/theme.css">
    <link rel="stylesheet" href="/assets/css/fonts.css">
    <link rel="stylesheet" href="/assets/css/header.css">
    <link rel="stylesheet" href="/assets/css/pre.css">
    <link rel="stylesheet" href="/assets/css/news.css">

    <script src="/assets/js/theme.js"></script>
    <script defer data-domain="omarchy.org" src="https://plausible.io/js/script.js"></script>
  </head>

  <body class="news-body">
    <div class="pre<%= " pre--news" if article %>">
