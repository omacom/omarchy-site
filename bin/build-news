#!/usr/bin/env ruby

begin
  require "kramdown"
  require "kramdown-parser-gfm"
rescue LoadError
  abort "Missing gems. Run: gem install kramdown kramdown-parser-gfm"
end

require "cgi"
require "date"
require "erb"
require "fileutils"
require "yaml"

SITE_ROOT = File.expand_path("..", __dir__)
CONTENT_DIR = File.join(SITE_ROOT, "content", "news")
NEWS_DIR = File.join(SITE_ROOT, "news")
TEMPLATE_DIR = File.join(SITE_ROOT, "templates", "news")
RELATIVE_ASSET = %r{\]\((?!\w+:|[/#])([^)]+)\)}

Post = Struct.new(:source, :title, :date, :author, :author_url, :description, :html, :path, :assets, keyword_init: true)

def h(text) = CGI.escapeHTML(text.to_s)

def format_date(date)
  date.strftime("%B %-d, %Y")
end

def render(template, locals = {})
  scope = binding
  locals.each { |name, value| scope.local_variable_set(name, value) }
  ERB.new(File.read(File.join(TEMPLATE_DIR, "#{template}.html.erb")), trim_mode: "-").result(scope)
end

def split_front_matter(source, file)
  return [{}, source] unless source.start_with?("---\n")

  match = source.match(/\A---\s*\n(.*?)\n---\s*\n/m) or abort "Unclosed front matter in #{file}"
  metadata = YAML.safe_load(match[1], permitted_classes: [Date, Time], aliases: false) || {}
  [metadata.transform_keys(&:to_s), source[match.end(0)..]]
end

def plain_text(html)
  CGI.unescapeHTML(html.gsub(/<[^>]+>/, " ")).gsub(/\s+/, " ").strip
end

SITE_URL = "https://omarchy.org"
FEED_URL = "#{SITE_URL}/news/rss.xml"

def rfc822(date)
  date.new_offset(0).strftime("%a, %d %b %Y %H:%M:%S GMT")
end

def cdata(text)
  "<![CDATA[#{text.gsub("]]>", "]]]]><![CDATA[>")}]]>"
end

def write_feed(posts)
  items = posts.map do |post|
    # Feed readers have no site origin, so make asset and link URLs absolute.
    html = post.html.gsub(%r{(href|src)="/(?!/)}, %(\\1="#{SITE_URL}/))
    <<~ITEM
      <item>
        <title>#{h post.title}</title>
        <link>#{SITE_URL}#{post.path}</link>
        <guid isPermaLink="true">#{SITE_URL}#{post.path}</guid>
        <pubDate>#{rfc822(post.date)}</pubDate>
        <dc:creator>#{h post.author}</dc:creator>
        <description>#{cdata(post.description)}</description>
        <content:encoded>#{cdata(html)}</content:encoded>
      </item>
    ITEM
  end

  FileUtils.mkdir_p NEWS_DIR
  File.write(File.join(NEWS_DIR, "rss.xml"), <<~XML)
    <?xml version="1.0" encoding="UTF-8"?>
    <rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/">
      <channel>
        <title>Omarchy News</title>
        <link>#{SITE_URL}/news</link>
        <description>Notes on the people, ideas, and releases shaping Omarchy.</description>
        <language>en</language>
        <lastBuildDate>#{rfc822(posts.first.date)}</lastBuildDate>
        <atom:link href="#{FEED_URL}" rel="self" type="application/rss+xml"/>
    #{items.join("\n")}
      </channel>
    </rss>
  XML
end

def excerpt(text, length = 240)
  return text if text.length <= length

  "#{text[0, length - 1].sub(/\s+\S*\z/, "")}…"
end

def load_post(file)
  metadata, markdown = split_front_matter(File.read(file), file)
  heading = markdown[/^#\s+(.+?)\s*$/, 1]
  title = metadata["title"] || heading or abort "Add a title to #{file} front matter or as its first heading"
  markdown = markdown.sub(/^#\s+.+?\s*\n+/, "") if heading

  relative = file.delete_prefix("#{CONTENT_DIR}/").sub(/\.md\z/, "")
  year, month = relative.split("/")
  date = metadata["date"]
  date = DateTime.parse(date.to_s) if date
  date ||= DateTime.new(Integer(year), Integer(month), 1)

  assets = markdown.scan(RELATIVE_ASSET).flatten.uniq
  assets.each do |asset|
    next if File.file?(File.join(File.dirname(file), asset))
    abort "#{file.delete_prefix("#{SITE_ROOT}/")} links to #{asset}, but no such file sits next to it"
  end
  markdown = markdown.gsub(RELATIVE_ASSET) { "](/news/#{relative}/#{$1})" }

  html = Kramdown::Document.new(markdown, input: "GFM", hard_wrap: false, syntax_highlighter: nil).to_html
  description = metadata["description"] || excerpt(plain_text(html))

  Post.new(
    source: file,
    title: title,
    date: date,
    author: metadata["author"] || "Omarchy",
    author_url: metadata["author_url"],
    description: description,
    html: html,
    path: "/news/#{relative}",
    assets: assets
  )
end

def write_page(file, post)
  main = render("post", post: post)
  FileUtils.mkdir_p File.dirname(file)
  File.write file, render("layout", page_title: "#{post.title} — Omarchy News", main: main)
end

def build
  files = Dir[File.join(CONTENT_DIR, "[0-9][0-9][0-9][0-9]", "[0-9][0-9]", "*.md")]
  abort "No news posts found under content/news/YYYY/MM/" if files.empty?

  posts = files.map { |file| load_post(file) }.sort_by(&:date).reverse

  posts.each do |post|
    output = File.join(SITE_ROOT, post.path.delete_prefix("/"), "index.html")

    FileUtils.mkdir_p File.dirname(output)
    post.assets.each do |asset|
      FileUtils.cp File.join(File.dirname(post.source), asset), File.join(File.dirname(output), asset)
    end
    write_page output, post
  end

  write_feed posts

  puts "Built #{posts.size} news #{posts.size == 1 ? "post" : "posts"} into news/"
end

build
