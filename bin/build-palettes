#!/usr/bin/env ruby
# Regenerates the site palettes from the authoritative colors.toml of each theme in the omarchy
# repo, writing assets/css/palettes.css and the theme list inside assets/js/theme.js. Run it when
# Omarchy adds or changes a theme; don't edit either output by hand.
#
#   bin/build-palettes                   # fetch themes/*/colors.toml from omacom/omarchy (default branch)
#   bin/build-palettes ../omarchy/themes # build from a local checkout
#   bin/build-palettes /usr/share/omarchy/themes
#
# The site's own palette is Tokyo Night, hand-tuned brighter than the terminal theme it came
# from, so it is pinned below and stays the default. Everything else is derived: a theme missing
# a colour falls back to a near neighbour, one missing too many is skipped, and colours carrying
# small text are nudged in lightness until they clear 4.5:1 against that theme's backgrounds, and
# the homepage mark is rotated towards each theme's accent.

require "fileutils"
require "tmpdir"

SITE_ROOT = File.expand_path("..", __dir__)
SOURCE_TARBALL = "https://github.com/omacom/omarchy/archive/HEAD.tar.gz"
PALETTES_CSS = File.join(SITE_ROOT, "assets", "css", "palettes.css")
THEME_JS = File.join(SITE_ROOT, "assets", "js", "theme.js")
THEME_JS_MARKERS = [/^\/\/ >>> themes \(generated by bin\/build-palettes\)$/, /^\/\/ <<< themes$/]

# Every site token, and the colors.toml keys it reads in order of preference. A theme that
# omits a key falls back to the next one, so a sparse community theme still resolves.
TOKENS = {
  "background-night" => %w[background],
  "background-storm" => %w[lighter_background dark_background background],
  "terminal-black" => %w[muted selection dark_foreground],
  "terminal-white" => %w[foreground light_foreground],
  "foreground-bright" => %w[bright_foreground light_foreground foreground],
  "terminal-blue" => %w[accent blue],
  "terminal-cyan" => %w[cyan blue accent],
  "turquoise" => %w[bright_cyan cyan accent],
  "green" => %w[green accent]
}

# The site's palette is Tokyo Night, hand-tuned brighter than the terminal theme it came from.
# Pinning it keeps the default look byte-identical instead of regressing it to the derived values.
PINNED = {
  "tokyo-night" => {
    "background-night" => "26, 27, 38", "background-storm" => "36, 40, 59",
    "terminal-black" => "65, 72, 104", "terminal-white" => "192, 202, 245",
    "foreground-bright" => "255, 255, 255", "terminal-blue" => "122, 162, 247",
    "terminal-cyan" => "125, 207, 255", "turquoise" => "180, 249, 248",
    "green" => "158, 206, 106"
  }
}

# Tokens that carry small text against the page. A terminal palette is tuned for a terminal,
# where these mostly sit on large glyphs, so several themes land under the 4.5:1 the web wants
# for body copy — Rose Pine's cyan against its own background is 2.6:1. Each of these is nudged
# in lightness, hue and saturation untouched, until it clears the bar against both grounds it
# can land on: the page itself, and the panel colour under code blocks and search results.
CONTRAST_TOKENS = %w[terminal-blue terminal-cyan terminal-white foreground-bright green turquoise]
MINIMUM_CONTRAST = 4.5

# The homepage effect paints in its own colours and the wasm takes no palette, so the mark comes
# out in Tokyo Night's blues whatever the page is wearing. Rotating the finished canvas by the
# distance between Tokyo Night's accent and this theme's lands it in the right family instead —
# green on Osaka Jade, warm on Ristretto. A rotation too small to notice isn't worth a rule, and
# a grey accent has no hue to rotate towards, so both are skipped.
MARK_BASE = "tokyo-night"
MARK_MINIMUM_ROTATION = 10
MARK_MINIMUM_SATURATION = 0.15

Theme = Struct.new(:slug, :name, :mode, :rgb, keyword_init: true)

def titleize(slug) = slug.split("-").map(&:capitalize).join(" ")

def parse_colors(file)
  File.readlines(file).each_with_object({}) do |line, colors|
    key, value = line.match(/^\s*(\w+)\s*=\s*"([^"]*)"/)&.captures
    colors[key] = value if key
  end
end

def to_rgb(hex)
  digits = hex.to_s.delete_prefix("#")
  digits = digits.chars.map { |c| c * 2 }.join if digits.length == 3
  return nil unless digits.match?(/\A[0-9a-fA-F]{6}\z/)
  digits.scan(/../).map { |pair| pair.to_i(16) }.join(", ")
end

def relative_luminance(rgb)
  channels = rgb.split(",").map { |value| value.strip.to_f / 255 }
  linear = channels.map { |value| value <= 0.03928 ? value / 12.92 : ((value + 0.055) / 1.055)**2.4 }
  0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2]
end

def contrast(one, other)
  lighter, darker = [relative_luminance(one), relative_luminance(other)].minmax.reverse
  (lighter + 0.05) / (darker + 0.05)
end

def to_hsl(rgb)
  red, green, blue = rgb.split(",").map { |value| value.strip.to_f / 255 }
  max, min = [red, green, blue].minmax.reverse
  lightness = (max + min) / 2
  return [0.0, 0.0, lightness] if max == min

  delta = max - min
  saturation = lightness > 0.5 ? delta / (2 - max - min) : delta / (max + min)
  hue = case max
        when red then ((green - blue) / delta) % 6
        when green then (blue - red) / delta + 2
        else (red - green) / delta + 4
        end
  [hue * 60, saturation, lightness]
end

def from_hsl(hue, saturation, lightness)
  chroma = (1 - (2 * lightness - 1).abs) * saturation
  second = chroma * (1 - ((hue / 60) % 2 - 1).abs)
  match = lightness - chroma / 2
  red, green, blue = case hue
                     when 0...60 then [chroma, second, 0]
                     when 60...120 then [second, chroma, 0]
                     when 120...180 then [0, chroma, second]
                     when 180...240 then [0, second, chroma]
                     when 240...300 then [second, 0, chroma]
                     else [chroma, 0, second]
                     end
  [red, green, blue].map { |value| ((value + match) * 255).round.clamp(0, 255) }.join(", ")
end

# Walk the colour away from the backgrounds one percent of lightness at a time. The page ground
# sets the direction — darker on a light theme, lighter on a dark one — and every ground has to
# clear the bar. Bailing out at pure black or white keeps a colour that can never get there from
# looping forever.
def raise_contrast(color, backgrounds)
  hue, saturation, lightness = to_hsl(color)
  step = relative_luminance(backgrounds.first) > 0.5 ? -0.01 : 0.01
  adjusted = color

  100.times do
    break if backgrounds.all? { |background| contrast(adjusted, background) >= MINIMUM_CONTRAST }

    lightness = (lightness + step).clamp(0.0, 1.0)
    adjusted = from_hsl(hue, saturation, lightness)
    break if lightness.zero? || lightness == 1.0
  end

  adjusted
end

def load_themes(dir)
  files = Dir[File.join(dir, "*", "colors.toml")].sort
  abort "No colors.toml found in #{dir}" if files.empty?

  files.filter_map do |file|
    slug = File.basename(File.dirname(file))
    colors = parse_colors(file)
    rgb = TOKENS.transform_values { |keys| to_rgb(colors.values_at(*keys).compact.first) }

    if rgb.value?(nil)
      warn "Skipping #{slug}: missing #{rgb.select { |_, value| value.nil? }.keys.join(", ")}"
      next
    end

    rgb = PINNED.fetch(slug) { legible(slug, rgb) }
    Theme.new(slug: slug, name: titleize(slug), mode: colors["mode"] == "light" ? "light" : "dark", rgb: rgb)
  end
end

def legible(slug, rgb)
  backgrounds = rgb.values_at("background-night", "background-storm")

  rgb.to_h do |token, color|
    next [token, color] unless CONTRAST_TOKENS.include?(token)

    raised = raise_contrast(color, backgrounds)
    warn "  #{slug}: raised #{token} from #{color} to #{raised}" unless raised == color
    [token, raised]
  end
end

# Plain attribute selectors, not :root ones, so a swatch button carrying the attribute paints
# itself in its own palette without a second set of generated rules.
def render_css(themes)
  blocks = themes.map do |theme|
    declarations = theme.rgb.map { |token, value| "  --rgb-#{token}: #{value};" }
    <<~CSS.rstrip
      [data-omarchy-theme="#{theme.slug}"] {
        color-scheme: #{theme.mode};
      #{declarations.join("\n")}
      }
    CSS
  end

  <<~CSS
    /* Generated by bin/build-palettes from the colors.toml of each Omarchy theme. Don't edit by hand. */

    #{blocks.join("\n\n")}

    #{render_mark(themes)}
  CSS
end

# The homepage mark is a canvas of bright strokes on solid black, blended with `screen` so the
# black drops out. Screen only ever lightens, so over a light page the whole mark vanishes.
# Inverting the canvas and multiplying is the same trick the other way up: white is what drops
# out of a multiply, and the strokes darken instead of lightening. Either way the hue-rotate
# carries the mark into the theme's own colours, and on a light palette it also has to undo the
# half-turn the invert put the hues through, which is what the extra 180 is doing.
def render_mark(themes)
  base_hue, = to_hsl(PINNED.fetch(MARK_BASE).fetch("terminal-blue"))

  blocks = themes.filter_map do |theme|
    rotation = mark_rotation(theme.rgb, base_hue)
    light = theme.mode == "light"
    next if rotation.zero? && !light

    declarations = [light ? "  filter: invert(1) hue-rotate(#{180 + rotation}deg);" : "  filter: hue-rotate(#{rotation}deg);"]
    declarations << "  mix-blend-mode: multiply;" if light

    <<~CSS.rstrip
      html.wte-home[data-omarchy-theme="#{theme.slug}"] .pre__wte canvas {
      #{declarations.join("\n")}
      }
    CSS
  end

  return "" if blocks.empty?

  <<~CSS.rstrip
    /* The mark is bright strokes on black, screened onto the page so the black drops out —
       which only works over a dark one. A light palette inverts and multiplies instead, and
       every palette rotates the effect's own blues towards its accent. */
    #{blocks.join("\n\n")}
  CSS
end

def mark_rotation(rgb, base_hue)
  hue, saturation, = to_hsl(rgb["terminal-blue"])
  return 0 if saturation < MARK_MINIMUM_SATURATION

  delta = ((hue - base_hue + 540) % 360) - 180
  delta.abs < MARK_MINIMUM_ROTATION ? 0 : delta.round
end

def render_js_list(themes)
  entries = themes.map { |theme| %(  { slug: "#{theme.slug}", name: "#{theme.name}", mode: "#{theme.mode}" }) }
  "const THEMES = [\n#{entries.join(",\n")}\n];"
end

def rewrite_theme_js(themes)
  opening, closing = THEME_JS_MARKERS
  lines = File.readlines(THEME_JS)
  first = lines.index { |line| line.match?(opening) }
  last = lines.index { |line| line.match?(closing) }
  abort "Missing generated-theme markers in #{THEME_JS}" unless first && last

  lines[(first + 1)...last] = "#{render_js_list(themes)}\n"
  File.write THEME_JS, lines.join
end

def build(dir)
  themes = load_themes(dir)
  File.write PALETTES_CSS, render_css(themes)
  rewrite_theme_js themes
  puts "Built #{themes.size} palettes into assets/css/palettes.css and assets/js/theme.js"
end

def fetch_source
  Dir.mktmpdir do |tmp|
    system "curl -fsSL #{SOURCE_TARBALL} | tar xz -C #{tmp} --strip-components=1 --wildcards '*/themes/*/colors.toml'", exception: true
    yield File.join(tmp, "themes")
  end
end

ARGV[0] ? build(ARGV[0]) : fetch_source { |dir| build(dir) }
